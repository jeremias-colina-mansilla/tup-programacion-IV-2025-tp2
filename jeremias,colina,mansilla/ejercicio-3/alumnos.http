@baseUrl = http://localhost:3000
@alumnoId = 1
@materiaId = 1

### ========================================
### LISTAR TODOS LOS ALUMNOS
### ========================================
GET {{baseUrl}}/alumnos HTTP/1.1
Content-Type: application/json

### ========================================
### CREAR ALUMNO
### ========================================
POST {{baseUrl}}/alumnos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Juan Pérez",
  "id_materia": 1,
  "nota1": 8.5,
  "nota2": 7.0,
  "nota3": 9.0
}

### ========================================
### CREAR ALUMNO (sin notas)
### ========================================
POST {{baseUrl}}/alumnos HTTP/1.1
Content-Type: application/json

{
  "nombre": "María García",
  "id_materia": 2,
  "nota1": null,
  "nota2": null,
  "nota3": null
}

### ========================================
### CREAR ALUMNO (validación - materia no existe)
### ========================================
POST {{baseUrl}}/alumnos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Pedro López",
  "id_materia": 999,
  "nota1": 7.5,
  "nota2": 8.0,
  "nota3": 6.5
}

### ========================================
### CREAR ALUMNO (validación - sin nombre)
### ========================================
POST {{baseUrl}}/alumnos HTTP/1.1
Content-Type: application/json

{
  "id_materia": 1,
  "nota1": 8.0,
  "nota2": 8.0,
  "nota3": 8.0
}

### ========================================
### CREAR ALUMNO (validación - id_materia inválido)
### ========================================
POST {{baseUrl}}/alumnos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Carlos Ruiz",
  "id_materia": "abc",
  "nota1": 7.0,
  "nota2": 8.0,
  "nota3": 7.5
}

### ========================================
### MODIFICAR ALUMNO
### ========================================
PUT {{baseUrl}}/alumnos/{{alumnoId}} HTTP/1.1
Content-Type: application/json

{
  "nombre": "Juan Pérez Modificado",
  "id_materia": 1,
  "nota1": 9.0,
  "nota2": 8.5,
  "nota3": 9.5
}

### ========================================
### MODIFICAR ALUMNO (cambiar materia)
### ========================================
PUT {{baseUrl}}/alumnos/2 HTTP/1.1
Content-Type: application/json

{
  "nombre": "María García",
  "id_materia": 3,
  "nota1": 7.0,
  "nota2": 8.0,
  "nota3": 7.5
}

### ========================================
### MODIFICAR ALUMNO (validación - no existe)
### ========================================
PUT {{baseUrl}}/alumnos/999 HTTP/1.1
Content-Type: application/json

{
  "nombre": "Alumno Inexistente",
  "id_materia": 1,
  "nota1": 8.0,
  "nota2": 8.0,
  "nota3": 8.0
}

### ========================================
### ELIMINAR ALUMNO
### ========================================
DELETE {{baseUrl}}/alumnos/{{alumnoId}} HTTP/1.1

### ========================================
### ELIMINAR ALUMNO (validación - no existe)
### ========================================
DELETE {{baseUrl}}/alumnos/999 HTTP/1.1